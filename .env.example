# Environment variables for Render deployment
# Copy this file to .env and fill in the actual values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-make-it-long-and-random
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=u-notes.onrender.com,www.u-notes.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://u-notes.onrender.com,https://www.u-notes.onrender.com

# Security Settings
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_SECURE_BROWSER_XSS_FILTER=True
DJANGO_X_FRAME_OPTIONS=DENY

# Database (Render persistent disk)
DJANGO_SQLITE_PATH=/var/data/db.sqlite3
DJANGO_MEDIA_ROOT=/var/data/media

# Optional: OpenAI API Key (for future enhanced AI features)
OPENAI_API_KEY=

# Optional: Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
